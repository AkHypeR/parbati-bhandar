# Cloudflare Pages runtime configuration
# Set these in Cloudflare Dashboard → Workers & Pages → parbati-bhandar
# → Settings → Variables and Secrets. Do not commit real secrets here.

# Required Pages secrets
# OWNER_PASSWORD=your-long-owner-password
# SESSION_SECRET=your-random-secret-at-least-32-characters
# TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret

# Required/optional Cloudinary credentials for product and store images
# CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Optional customer push notifications
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:you@example.com
